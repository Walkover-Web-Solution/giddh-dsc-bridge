{
  "manifest_version": 3,
  "name": "Giddh DSC Bridge",
  "version": "1.2.0",
  "description": "Connects Giddh e-signature to hardware DSC tokens via PKCS#11. No per-origin license required.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge-inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
