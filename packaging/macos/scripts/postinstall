#!/bin/bash
# Runs as root after the payload is laid down. Registers the native-messaging
# manifest system-wide for every Chromium-family browser so Chrome can launch
# the Giddh DSC host. Idempotent — safe to re-run.
set -e

INSTALL_DIR="/usr/local/giddh-dsc-bridge"
HOST_NAME="com.giddh.dsc.bridge"
SRC="$INSTALL_DIR/$HOST_NAME.json"

# System-level native-messaging host directories (root-writable).
DIRS=(
  "/Library/Google/Chrome/NativeMessagingHosts"
  "/Library/Google/Chrome Beta/NativeMessagingHosts"
  "/Library/Microsoft/Edge/NativeMessagingHosts"
  "/Library/Application Support/Chromium/NativeMessagingHosts"
  "/Library/Application Support/BraveSoftware/Brave-Browser/NativeMessagingHosts"
)

for d in "${DIRS[@]}"; do
  mkdir -p "$d"
  cp "$SRC" "$d/$HOST_NAME.json"
  chmod 644 "$d/$HOST_NAME.json"
done

# Chrome prefers *user-level* NativeMessagingHosts over system ones. Older
# companion apps copied the signed host into ~/Library/Application Support,
# which breaks the Python framework signature and yields
# "Native host has exited". Remove those leftovers for every local user so
# the system host registered above is the one Chrome actually launches.
USER_NMH_REL_PATHS=(
  "Library/Application Support/Google/Chrome/NativeMessagingHosts"
  "Library/Application Support/Google/Chrome Beta/NativeMessagingHosts"
  "Library/Application Support/BraveSoftware/Brave-Browser/NativeMessagingHosts"
  "Library/Application Support/Microsoft Edge/NativeMessagingHosts"
  "Library/Application Support/Chromium/NativeMessagingHosts"
)

for home in /Users/*; do
  [ -d "$home" ] || continue
  case "$(basename "$home")" in
    Shared|Guest) continue ;;
  esac
  rm -rf "$home/Library/Application Support/Giddh DSC Bridge"
  for rel in "${USER_NMH_REL_PATHS[@]}"; do
    rm -f "$home/$rel/$HOST_NAME.json"
  done
done

# Strip quarantine so Gatekeeper does not block Chrome launching the host.
xattr -dr com.apple.quarantine "$INSTALL_DIR" 2>/dev/null || true
xattr -dr com.apple.quarantine "/Applications/Giddh DSC Bridge.app" 2>/dev/null || true

exit 0
