#!/bin/bash
# Registers the native-messaging manifest system-wide for Chromium browsers.
set -e

INSTALL_DIR="/opt/giddh-dsc-bridge"
HOST_NAME="com.giddh.dsc.bridge"
SRC="$INSTALL_DIR/$HOST_NAME.json"

DIRS=(
  "/etc/opt/chrome/native-messaging-hosts"
  "/etc/chromium/native-messaging-hosts"
  "/etc/opt/edge/native-messaging-hosts"
  "/etc/opt/brave/native-messaging-hosts"
)

for d in "${DIRS[@]}"; do
  mkdir -p "$d"
  cp "$SRC" "$d/$HOST_NAME.json"
  chmod 644 "$d/$HOST_NAME.json"
done

# Refresh the application menu so the companion app appears immediately.
command -v update-desktop-database >/dev/null 2>&1 && \
  update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

exit 0
